#!/usr/bin/env bash
# dmp-root: the only way devmagic-panel does anything as root.
#
# Installed root-owned in /usr/local/lib/devmagic-panel/bin and allowed
# without a password by /etc/sudoers.d/devmagic-panel. Every argument is
# validated here and every path comes from /etc/devmagic-panel/config.env,
# never from the caller.
set -euo pipefail

DMP_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
for lib in log config validate apache php fpm php-apt ca cert vhost nginx hosts backup site trash mysql; do
  # shellcheck source=/dev/null
  source "$DMP_HOME/lib/$lib.sh"
done

usage() {
  cat <<'EOF'
Usage: dmp-root <command> [args]

  backup                              archive certs, vhosts, hosts and system CAs
  ca-create                           create the local CA if missing
  ca-trust                            add the CA to the system trust store
  ca-untrust-legacy                   remove the old devmagic LocalhostCA from the system store
  cert-issue <domain> [alias...]      issue a cert for the domain and its aliases
  cert-reissue-from-vhost <domain>    reissue a cert with every name in the site's vhost
  vhost-write <domain> [--uploads-proxy <host>] [--mount /path=folder]... [alias...]
                                      write, enable and test a site vhost, then reload;
                                      --uploads-proxy sends missing uploads to that host;
                                      --mount serves the folder WEB_DIR/<folder> at /path
  vhost-write-panel                   write the vhost that proxies to the panel
  vhost-remove <domain>               disable and remove a site vhost
  nginx-site-write <domain> [--kind single|subdirectory|subdomain] [--uploads-proxy <host>]
                   [--mount /path=folder]... [alias...]
                                      the site on nginx (NGINX_ADDRESS), from WEB_DIR/<domain>,
                                      its PHP through PHP-FPM; kind picks WordPress's rules;
                                      --mount serves the folder WEB_DIR/<folder> at /path;
                                      nginx -t, then reload; hosts-add then points it there
  nginx-site-write <domain> --upstream apache [--static on|off] [--apache-path /path]... [alias...]
                                      nginx in front of the site's Apache vhost (NGINX_ADDRESS),
                                      which reads .htaccess and runs its PHP; with --static on
                                      nginx serves images, CSS, JS and fonts, but in the folders
                                      of --apache-path (each with an .htaccess of its own)
  nginx-site-remove <domain>          take a site off nginx
  hosts-add <domain> [alias...]       add or replace the site's /etc/hosts line
  hosts-remove <domain>               remove the site's /etc/hosts line
  site-dir-create <domain>            create the site folder under the web root
  site-dir-remove <domain>            remove a site folder the panel created
  site-marker-migrate                 move markers older versions left in site folders
                                      into the registry in STATE_DIR
  trash-site <domain> <stamp> <db> <user> [reason]
                                      archive a site (folder, vhosts, cert, database dump
                                      exported as <domain>-<stamp>.sql.gz) into the trash;
                                      db and user may be -; reason is deleted (default),
                                      reinstall or restore
  trash-remove <domain> <stamp>       remove a site whose archive checks out
  trash-list                          list deleted sites, tab-separated
  trash-restore <id>                  put a deleted site back when nothing of it exists
  trash-delete <id>                   delete a trash entry for good
  trash-purge <days>                  delete trash entries older than that
  cert-remove <domain>                remove a cert no vhost uses any more
  apache-module-enable <module>       enable an allowed Apache module
  apache-module <name> <on|off>       a module in mods-available on or off, then a
                                      configtest (taken back when it fails) and a
                                      restart; never php* or mpm_*, never off for
                                      the panel's own modules and core ones
  apache-configtest                   run apache2ctl configtest
  apache-reload                       configtest, then reload Apache
  service-restart <apache|mysql|nginx>
                                      restart Apache or nginx (after a configtest) or MySQL
  nginx-setup                         nginx on NGINX_ADDRESS next to Apache, which moves from
                                      every address to APACHE_ADDRESS; Debian's default nginx
                                      site off; run again, it writes the panel's settings anew
  nginx-teardown                      Apache back on every address, nginx stopped; refused
                                      while a site runs on nginx
  nginx-configtest                    run nginx -t
  nginx-reload                        nginx -t, then reload nginx
  xdebug-enable [version] <mode> <start>
                                      Xdebug on for a version's web parts (mod_php, FPM),
                                      then Apache or FPM picks it up; without a version,
                                      the one Apache loads; mode: debug develop profile
                                      trace coverage, a comma list; start: trigger or yes;
                                      profile and trace write to STATE_DIR/profiles/<version>
  xdebug-disable [version]            Xdebug off for a version's web parts
  php-module [version] <name> <on|off>
                                      a module installed for a version on or off for
                                      all its parts (apache2, fpm, cli); never xdebug,
                                      and never off for mysqli mysqlnd pdo xml
  php-ini <version> <web|cli> [key=value...]
                                      the panel's 99-devmagic-panel.ini for a version's
                                      web parts or command line, with exactly these
                                      allow-listed settings; none removes it
  php-ini-reset <version> <apache2|fpm|cli>
                                      the packaged php.ini again, the current one saved
  mysql-config-write [name=value...]  the panel's zz-devmagic-panel.cnf in mysql.conf.d
                                      (or mariadb.conf.d) with exactly these allow-listed
                                      settings, whole numbers inside bounds; none removes it
  php-ini-put-back <version> <apache2|fpm|cli> <saved>
                                      the php.ini php-ini-reset saved
  php-pool-write <folder> <version> [key=value...]
                                      the site in WEB_DIR/<folder> runs on PHP <version>
                                      through its own FPM pool, with these settings
  php-pool-remove <folder>            the site goes back to the PHP every site runs
  php-fpm-match <version>             FPM of a version gets mod_php's modules, settings
                                      and php.ini
  php-switch-fpm <version>            mod_php off, Apache on mpm_event, every site
                                      without a pool on PHP <version> through PHP-FPM
  php-switch-modphp <version>         mod_php of a version back on, mpm_prefork, and
                                      sites without a pool back on it
  php-install <version>               a version from apt with FPM, the command line and
                                      the common modules (sources apt already has only)
  php-package <version> <name> <install|remove>
                                      one php<version>-<name> package
  php-upgrade <version>               the newest build of every php<version> package
  php-remove <version>                every php<version> package; refused while Apache,
                                      the command line or a site's pool uses it
  php-cli <version>                   php on the command line (WP-CLI, Composer) on
                                      that version, through update-alternatives

Exit codes: 0 success, 1 operation failed, 2 bad usage or input.
EOF
}

# Validates the domain and every alias, then runs the given function.
with_names() {
  local fn="$1"
  shift
  (( $# >= 1 )) || dmp_usage_error "a domain is required"
  local name
  for name in "$@"; do
    dmp_require_local_name "$name"
  done
  "$fn" "$@"
}

# vhost-write <domain> [--uploads-proxy <host>] [--mount /path=folder]... [alias...]
vhost_write() {
  (( $# >= 1 )) || dmp_usage_error "a domain is required"
  local domain="$1" proxy=""
  shift
  if [[ "${1:-}" == --uploads-proxy ]]; then
    (( $# >= 2 )) || dmp_usage_error "--uploads-proxy needs a hostname"
    dmp_require_hostname "$2"
    proxy="$2"
    shift 2
  fi
  # Sites under a path: --mount /learn=local.learn.shop.com, a folder in WEB_DIR that exists.
  local spec at folder
  while [[ "${1:-}" == --mount ]]; do
    if (( $# < 2 )) || [[ "$2" != /*=* ]]; then
      dmp_usage_error "--mount needs /path=folder"
    fi
    spec="$2"
    at="${spec%%=*}"
    folder="${spec#*=}"
    dmp_require_mount_path "$at"
    dmp_require_local_name "$folder"
    [[ "$folder" != "$domain" ]] || dmp_usage_error "a site cannot be mounted into itself"
    [[ -d "$WEB_DIR/$folder" && ! -L "$WEB_DIR/$folder" ]] || dmp_die "no folder $WEB_DIR/$folder"
    DMP_VHOST_MOUNTS+=("$at=$folder")
    shift 2
  done
  local name
  for name in "$domain" "$@"; do
    dmp_require_local_name "$name"
  done
  dmp_vhost_write_site "$domain" "$proxy" "$@"
}

# nginx-site-write <domain> [--kind ...] [--uploads-proxy <host>] [--mount /path=folder]... [alias...]
# nginx-site-write <domain> --upstream apache [--static on|off] [--apache-path /path]... [alias...]
nginx_site_write() {
  (( $# >= 1 )) || dmp_usage_error "a domain is required"
  local domain="$1" kind=single proxy="" name at folder upstream="" static=on php_opts=0
  shift
  while [[ "${1:-}" == --* ]]; do
    (( $# >= 2 )) || dmp_usage_error "$1 needs a value"
    case "$1" in
      --kind) dmp_in_list "$2" "${DMP_NGINX_KINDS[@]}" || dmp_usage_error "--kind takes ${DMP_NGINX_KINDS[*]}, not: $2"; kind="$2"; php_opts=1 ;;
      --uploads-proxy) dmp_require_hostname "$2"; proxy="$2"; php_opts=1 ;;
      # nginx in front of the site's Apache vhost, which reads .htaccess and runs its PHP.
      --upstream) [[ "$2" == apache ]] || dmp_usage_error "--upstream takes apache, not: $2"; upstream=apache ;;
      --static) [[ "$2" == on || "$2" == off ]] || dmp_usage_error "--static takes on or off, not: $2"; static="$2" ;;
      # A folder of the site with an .htaccess of its own, which always goes to Apache.
      --apache-path)
        dmp_require_mount_path "$2"
        dmp_require_local_name "$domain"
        dmp_nginx_apache_path_ok "$domain" "$2" || dmp_die "no folder $WEB_DIR/$domain$2 with an .htaccess of its own"
        DMP_NGINX_APACHE_PATHS+=("$2")
        ;;
      # As vhost-write's: a path of letters, digits, . _ - and a folder in WEB_DIR that exists.
      --mount)
        [[ "$2" == /*=* ]] || dmp_usage_error "--mount needs /path=folder"
        at="${2%%=*}"
        folder="${2#*=}"
        dmp_require_mount_path "$at"
        dmp_require_local_name "$folder"
        [[ "$folder" != "$domain" ]] || dmp_usage_error "a site cannot be mounted into itself"
        [[ -d "$WEB_DIR/$folder" && ! -L "$WEB_DIR/$folder" ]] || dmp_die "no folder $WEB_DIR/$folder"
        DMP_NGINX_MOUNTS+=("$at=$folder")
        php_opts=1
        ;;
      *) dmp_usage_error "unknown option: $1" ;;
    esac
    shift 2
  done
  for name in "$domain" "$@"; do
    dmp_require_local_name "$name"
  done
  if [[ -n "$upstream" ]]; then
    # Apache's vhost has the WordPress rules, the uploads redirect and the sites under paths.
    (( php_opts == 0 )) || dmp_usage_error "--kind, --uploads-proxy and --mount are for a site on nginx's own PHP, not in front of Apache"
    dmp_nginx_front_write "$domain" "$static" "$@"
    return
  fi
  [[ "$static" == on && ${#DMP_NGINX_APACHE_PATHS[@]} -eq 0 ]] || dmp_usage_error "--static and --apache-path need --upstream apache"
  dmp_nginx_site_write "$domain" "$kind" "$proxy" "$@"
}

main() {
  local cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 2; }
  shift
  case "$cmd" in
    -h | --help | help) usage; exit 0 ;;
  esac

  dmp_load_config

  case "$cmd" in
    backup) (( $# == 0 )) || dmp_usage_error "backup takes no arguments"; dmp_backup ;;
    ca-create) (( $# == 0 )) || dmp_usage_error "ca-create takes no arguments"; dmp_ca_create ;;
    ca-trust) (( $# == 0 )) || dmp_usage_error "ca-trust takes no arguments"; dmp_ca_trust ;;
    ca-untrust-legacy) (( $# == 0 )) || dmp_usage_error "ca-untrust-legacy takes no arguments"; dmp_ca_untrust_legacy ;;
    cert-issue) with_names dmp_cert_issue "$@" ;;
    cert-reissue-from-vhost) (( $# == 1 )) || dmp_usage_error "cert-reissue-from-vhost takes one domain"; with_names dmp_cert_reissue_from_vhost "$@" ;;
    vhost-write) vhost_write "$@" ;;
    vhost-write-panel) (( $# == 0 )) || dmp_usage_error "vhost-write-panel takes no arguments"; dmp_require_local_name "$PANEL_DOMAIN"; dmp_vhost_write_panel ;;
    vhost-remove) (( $# == 1 )) || dmp_usage_error "vhost-remove takes one domain"; with_names dmp_vhost_remove "$@" ;;
    hosts-add) with_names dmp_hosts_add "$@" ;;
    hosts-remove) (( $# == 1 )) || dmp_usage_error "hosts-remove takes one domain"; with_names dmp_hosts_remove "$@" ;;
    site-dir-create) (( $# == 1 )) || dmp_usage_error "site-dir-create takes one domain"; with_names dmp_site_dir_create "$@" ;;
    site-dir-remove) (( $# == 1 )) || dmp_usage_error "site-dir-remove takes one domain"; with_names dmp_site_dir_remove "$@" ;;
    site-marker-migrate) (( $# == 0 )) || dmp_usage_error "site-marker-migrate takes no arguments"; dmp_site_marker_migrate ;;
    trash-site) (( $# == 4 || $# == 5 )) || dmp_usage_error "trash-site takes a domain, a stamp, a database, a user and an optional reason"; dmp_require_local_name "$1"; dmp_trash_site "$@" ;;
    trash-remove) (( $# == 2 )) || dmp_usage_error "trash-remove takes a domain and a stamp"; dmp_require_local_name "$1"; dmp_trash_remove "$@" ;;
    trash-list) (( $# == 0 )) || dmp_usage_error "trash-list takes no arguments"; dmp_trash_list ;;
    trash-restore) (( $# == 1 )) || dmp_usage_error "trash-restore takes an id"; dmp_trash_restore "$1" ;;
    trash-delete) (( $# == 1 )) || dmp_usage_error "trash-delete takes an id"; dmp_trash_delete "$1" ;;
    trash-purge) (( $# == 1 )) || dmp_usage_error "trash-purge takes a number of days"; dmp_trash_purge "$1" ;;
    cert-remove) (( $# == 1 )) || dmp_usage_error "cert-remove takes one domain"; with_names dmp_cert_remove "$@" ;;
    apache-module-enable) (( $# == 1 )) || dmp_usage_error "apache-module-enable takes one module"; dmp_apache_module_enable "$1" ;;
    apache-module) (( $# == 2 )) || dmp_usage_error "apache-module takes a module and on or off"; dmp_apache_module "$1" "$2" ;;
    apache-configtest) dmp_apache_configtest || exit 1 ;;
    apache-reload) dmp_apache_reload ;;
    service-restart) (( $# == 1 )) || dmp_usage_error "service-restart takes apache, mysql or nginx"; dmp_service_restart "$1" ;;
    nginx-setup) (( $# == 0 )) || dmp_usage_error "nginx-setup takes no arguments"; dmp_require_local_name "$PANEL_DOMAIN"; dmp_nginx_setup ;;
    nginx-teardown) (( $# == 0 )) || dmp_usage_error "nginx-teardown takes no arguments"; dmp_nginx_teardown ;;
    nginx-configtest) (( $# == 0 )) || dmp_usage_error "nginx-configtest takes no arguments"; dmp_nginx_require_installed; dmp_nginx_configtest || exit 1 ;;
    nginx-site-write) nginx_site_write "$@" ;;
    nginx-site-remove) (( $# == 1 )) || dmp_usage_error "nginx-site-remove takes one domain"; with_names dmp_nginx_site_remove "$@" ;;
    nginx-reload) (( $# == 0 )) || dmp_usage_error "nginx-reload takes no arguments"; dmp_nginx_reload ;;
    xdebug-enable) (( $# == 2 || $# == 3 )) || dmp_usage_error "xdebug-enable takes an optional version, a mode and a start value"; dmp_xdebug_enable "$@" ;;
    xdebug-disable) (( $# <= 1 )) || dmp_usage_error "xdebug-disable takes an optional version"; dmp_xdebug_disable "$@" ;;
    php-module) (( $# == 2 || $# == 3 )) || dmp_usage_error "php-module takes an optional version, a module and on or off"; dmp_php_module "$@" ;;
    php-ini) (( $# >= 2 && $# <= 40 )) || dmp_usage_error "php-ini takes a version, web or cli, and key=value settings"; dmp_php_ini "$@" ;;
    mysql-config-write) (( $# <= 10 )) || dmp_usage_error "mysql-config-write takes up to 10 name=value settings"; dmp_mysql_config_write "$@" ;;
    php-ini-reset) (( $# == 2 )) || dmp_usage_error "php-ini-reset takes a version and apache2, fpm or cli"; dmp_php_ini_reset "$1" "$2" ;;
    php-pool-write) (( $# >= 2 && $# <= 40 )) || dmp_usage_error "php-pool-write takes a folder, a version and key=value settings"; dmp_php_pool_write "$@" ;;
    php-pool-remove) (( $# == 1 )) || dmp_usage_error "php-pool-remove takes a folder"; dmp_php_pool_remove "$1" ;;
    php-fpm-match) (( $# == 1 )) || dmp_usage_error "php-fpm-match takes a version"; dmp_php_fpm_match "$1" ;;
    php-switch-fpm) (( $# == 1 )) || dmp_usage_error "php-switch-fpm takes a version"; dmp_php_switch_fpm "$1" ;;
    php-switch-modphp) (( $# == 1 )) || dmp_usage_error "php-switch-modphp takes a version"; dmp_php_switch_modphp "$1" ;;
    php-install) (( $# == 1 )) || dmp_usage_error "php-install takes a version"; dmp_php_install "$1" ;;
    php-package) (( $# == 3 )) || dmp_usage_error "php-package takes a version, a name and install or remove"; dmp_php_package "$1" "$2" "$3" ;;
    php-upgrade) (( $# == 1 )) || dmp_usage_error "php-upgrade takes a version"; dmp_php_upgrade "$1" ;;
    php-remove) (( $# == 1 )) || dmp_usage_error "php-remove takes a version"; dmp_php_remove "$1" ;;
    php-cli) (( $# == 1 )) || dmp_usage_error "php-cli takes a version"; dmp_php_cli "$1" ;;
    php-ini-put-back) (( $# == 3 )) || dmp_usage_error "php-ini-put-back takes a version, apache2, fpm or cli, and a saved name"; dmp_php_ini_put_back "$1" "$2" "$3" ;;
    *) dmp_usage_error "unknown command: $cmd (see dmp-root --help)" ;;
  esac
}

main "$@"
